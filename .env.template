# Server Configuration
PORT=3000
HOST=localhost
JWT_SECRET=your-secret-key-here

# NATS Configuration
NATS_SERVERS=nats://localhost:4222

# PostgreSQL Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-password
DB_NAME=auth_db

# Keycloak Configuration
KEYCLOAK_DOMAIN=https://your-keycloak-domain.com
KEYCLOAK_REALM=your-realm
KEYCLOAK_CLIENT_ID=your-client-id
KEYCLOAK_CLIENT_SECRET=your-client-secret

# Keycloak Login
KEYCLOAK_LOGIN_URL=https://your-keycloak-domain.com/realms/your-realm/protocol/openid-connect/token

# Keycloak Admin
KEYCLOAK_ADMIN_BASE_URL=https://your-keycloak-domain.com
KEYCLOAK_ADMIN_CLIENT_ID=admin-client-id
KEYCLOAK_ADMIN_CLIENT_SECRET=admin-client-secret
KEYCLOAK_ADMIN_LINK_LIFESPAN=300
KEYCLOAK_ADMIN_REDIRECT_URI=http://localhost:3000/auth/callback

# Keycloak Client Login
KEYCLOAK_CLIENT_LOGIN_CLIENT_ID=login-client-id
KEYCLOAK_CLIENT_LOGIN_CLIENT_SECRET=login-client-secret
